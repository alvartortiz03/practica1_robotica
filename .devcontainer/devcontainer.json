{
  "name": "ROS 2 Jazzy - Robótica y Automatización Inteligente",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "desktop",
  "runServices": ["desktop"],
  "workspaceFolder": "/home/laboratorio/ros_workspace",
  "shutdownAction": "stopCompose",
  "forwardPorts": [6081],
  "portsAttributes": {
    "6081": {
      "label": "Escritorio (noVNC)",
      "onAutoForward": "openBrowserOnce"
    }
  },
  "remoteUser": "laboratorio",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-iot.vscode-ros"
      ]
    }
  }
}
